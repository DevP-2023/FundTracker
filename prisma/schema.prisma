// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  password             String
  currency             String                @default("INR")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accounts             Account[]
  categories           Category[]
  transactions         Transaction[]
  investments          Investment[]
  investmentTx         InvestmentTransaction[]
  loans                Loan[]
  loanRepayments       LoanRepayment[]
  budgets              Budget[]
  goals                Goal[]
  recurringTx          RecurringTransaction[]
  notifications        Notification[]
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         String        // cash, bank, savings, credit_card, upi, investment, wallet
  balance      Float         @default(0)
  currency     String        @default("INR")
  color        String?
  icon         String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  fromTransfers Transaction[] @relation("TransferFrom")
  toTransfers   Transaction[] @relation("TransferTo")
}

model Category {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String        // expense, income, both
  icon        String?
  color       String?
  parentId    String?
  parent      Category?     @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]    @relation("SubCategories")
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]
  budgets     Budget[]
}

model Transaction {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String       // expense, income, transfer, investment, lending, borrowing
  amount            Float
  description       String?
  notes             String?
  date              DateTime
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id])
  accountId         String?
  account           Account?     @relation(fields: [accountId], references: [id])
  transferFromId    String?
  transferFrom      Account?     @relation("TransferFrom", fields: [transferFromId], references: [id])
  transferToId      String?
  transferTo        Account?     @relation("TransferTo", fields: [transferToId], references: [id])
  paymentMethod     String?
  status            String       @default("completed") // completed, pending, cancelled
  tags              String?      // JSON array of tags
  investmentId      String?
  investment        Investment?  @relation(fields: [investmentId], references: [id])
  loanId            String?
  loan              Loan?        @relation(fields: [loanId], references: [id])
  recurringId       String?
  recurring         RecurringTransaction? @relation(fields: [recurringId], references: [id])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Investment {
  id            String                  @id @default(cuid())
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol        String?
  name          String
  type          String                  // stock, etf, mutual_fund, bond, crypto, other
  exchange      String?
  quantity      Float                   @default(0)
  avgBuyPrice   Float                   @default(0)
  currentPrice  Float                   @default(0)
  investedAmount Float                  @default(0)
  currentValue  Float                   @default(0)
  notes         String?
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  transactions  Transaction[]
  investmentTx  InvestmentTransaction[]
}

model InvestmentTransaction {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  type         String     // buy, sell
  quantity     Float
  price        Float
  amount       Float
  brokerage    Float      @default(0)
  date         DateTime
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Loan {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String          // lent, borrowed
  personName      String
  amount          Float
  remainingAmount Float
  purpose         String?
  status          String          @default("pending") // pending, partially_paid, completed, overdue
  date            DateTime
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  repayments      LoanRepayment[]
  transactions    Transaction[]
}

model LoanRepayment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  type       String    // overall, category
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  amount     Float
  period     String    // monthly, yearly
  month      Int?      // 1-12
  year       Int?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Goal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  color         String?
  icon          String?
  status        String   @default("active") // active, completed, paused
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RecurringTransaction {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String        // expense, income
  amount      Float
  description String?
  categoryId  String?
  accountId   String?
  frequency   String        // daily, weekly, monthly, yearly
  startDate   DateTime
  endDate     DateTime?
  nextDue     DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions Transaction[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // budget_warning, budget_exceeded, loan_due, goal_milestone, large_expense
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?  // JSON metadata
  createdAt DateTime @default(now())
}
